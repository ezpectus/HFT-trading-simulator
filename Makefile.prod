# ── Production Makefile ──
# Usage: make prod-up, make prod-down, make prod-logs, etc.

# --env-file is required: env_file: loads .env.prod into containers, but
# ${VAR:?required} interpolation in the compose file only reads --env-file
# (or the default .env). Without it every prod command fails on :?required.
DOCKER_COMPOSE = docker compose --env-file .env.prod -f docker-compose.prod.yml
SERVICES = exchange-simulator ai-signal-bot hft-trade-bot web-ui prometheus grafana

.PHONY: prod-up prod-down prod-build prod-rebuild prod-logs prod-ps prod-restart \
        prod-monitor prod-health prod-clean prod-stats

# ── Start / Stop ──

prod-up:
	$(DOCKER_COMPOSE) up -d

prod-down:
	$(DOCKER_COMPOSE) down

prod-stop:
	$(DOCKER_COMPOSE) stop

# ── Build ──

prod-build:
	$(DOCKER_COMPOSE) build

prod-rebuild:
	$(DOCKER_COMPOSE) build --no-cache

# ── Monitoring ──

prod-logs:
	$(DOCKER_COMPOSE) logs -f --tail=100

prod-logs-%:
	$(DOCKER_COMPOSE) logs -f --tail=100 $*

prod-ps:
	$(DOCKER_COMPOSE) ps

prod-restart:
	$(DOCKER_COMPOSE) restart

prod-restart-%:
	$(DOCKER_COMPOSE) restart $*

# ── Health & Monitoring ──

prod-monitor:
	@echo "Opening Grafana at http://localhost:3001"
	@open http://localhost:3001 2>/dev/null || xdg-open http://localhost:3001 2>/dev/null || start http://localhost:3001 2>/dev/null || echo "Open http://localhost:3001 in your browser"

prod-health:
	@echo "Checking all service health endpoints..."
	@echo -n "  Exchange Sim (:8765): "; (echo > /dev/tcp/localhost/8765) 2>/dev/null && echo "OK (port open)" || echo "FAIL (port closed)"; echo ""
	@echo -n "  AI Signal Bot (:8766): "; (echo > /dev/tcp/localhost/8766) 2>/dev/null && echo "OK (port open)" || echo "FAIL (port closed)"; echo ""
	@echo -n "  HFT Trade Bot (:9091): "; curl -s -o /dev/null -w "%{http_code}" http://localhost:9091/health 2>/dev/null || echo -n "FAIL"; echo ""
	@echo -n "  Prometheus (:9090): "; curl -s -o /dev/null -w "%{http_code}" http://localhost:9090/-/healthy 2>/dev/null || echo -n "FAIL"; echo ""
	@echo -n "  Web UI (:3000): "; curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/ 2>/dev/null || echo -n "FAIL"; echo ""
	@echo -n "  Grafana (:3001): "; curl -s -o /dev/null -w "%{http_code}" http://localhost:3001/api/health 2>/dev/null || echo -n "FAIL"; echo ""

# ── Cleanup ──

prod-clean:
	$(DOCKER_COMPOSE) down -v --remove-orphans
	docker system prune -f

prod-stats:
	@echo "Docker container stats:"
	@docker stats --no-stream $$($(DOCKER_COMPOSE) ps -q)

# ── Deploy ──

prod-deploy: prod-build prod-up prod-health
	@echo "Production deployment complete"

# ── Help ──

help:
	@echo "Production Makefile commands:"
	@echo "  make prod-up          - Start all services"
	@echo "  make prod-down        - Stop all services"
	@echo "  make prod-build       - Build all images"
	@echo "  make prod-rebuild     - Rebuild without cache"
	@echo "  make prod-logs        - Follow all logs"
	@echo "  make prod-logs-SERVICE - Follow specific service logs"
	@echo "  make prod-ps          - Show container status"
	@echo "  make prod-restart     - Restart all services"
	@echo "  make prod-monitor     - Open Grafana dashboard"
	@echo "  make prod-health      - Check all health endpoints"
	@echo "  make prod-clean       - Remove all containers and volumes"
	@echo "  make prod-deploy      - Build, deploy, and health check"
