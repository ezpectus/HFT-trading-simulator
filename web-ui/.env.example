# Web UI Environment Variables
# =============================
# Copy this file to .env and adjust as needed.
# All variables are optional — defaults use localhost.

# Exchange Simulator WebSocket URL (market data, order execution)
VITE_WS_EXCHANGE=ws://localhost:8765

# AI Signal Bot WebSocket URL (signals, market regime, backtest)
VITE_WS_SIGNALS=ws://localhost:8766

# Mock Mode — generate synthetic market data without backend
# Set to "true" to enable standalone demo mode (no exchange/signal bot needed)
# VITE_MOCK_MODE=true

# Default Settings
VITE_DEFAULT_EXCHANGE=binance
VITE_DEFAULT_SYMBOL=BTC/USDT
VITE_DEFAULT_TIMEFRAME=1h

# Feature Flags
VITE_ENABLE_ADVANCED_ORDERS=true
VITE_ENABLE_AUDIT_LOGS=true
VITE_ENABLE_EXCHANGE_CLONES=true
VITE_ENABLE_SYMBOL_SEARCH=true

# Notes:
# - For Docker, use ws://localhost:8765 / ws://localhost:8766 (ports are mapped to host)
# - For remote deployment, replace localhost with your server address
# - Set VITE_MOCK_MODE=true for portfolio demo without running backend services
# - .env is gitignored — never commit real connection strings
# - Feature flags control visibility of new features (advanced orders, audit logs, etc.)
