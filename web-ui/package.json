{
  "name": "trading-sim-web-ui",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "HFT Trading System Dashboard — 204 panels, 44+ math models, React 18 + Vite 8",
  "keywords": [
    "trading",
    "hft",
    "react",
    "dashboard",
    "crypto",
    "fintech",
    "visualization"
  ],
  "author": "Trading System",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:mock": "vite --host 0.0.0.0 --port 3000 --mode mock",
    "build": "vite build",
    "build:mock": "VITE_MOCK_MODE=true vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest",
    "test:run": "node --max-old-space-size=16384 node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --max-old-space-size=16384 node_modules/vitest/vitest.mjs run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/",
    "analyze": "vite-bundle-visualizer"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.33.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-vitals": "^6.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react": "^7.35.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-bundle-visualizer": "^1.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "fast-uri": ">=4.1.2",
    "js-yaml": ">=4.3.1"
  }
}
