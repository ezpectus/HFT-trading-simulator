# ─────────────────────────────────────────────────────────────────────────────
# Production environment variables — copy to .env.prod and fill in secrets
# ─────────────────────────────────────────────────────────────────────────────
# NEVER commit .env.prod to version control!
# All passwords below are placeholders — you MUST replace them with strong secrets.
# Validation: docker-compose.prod.yml uses ${VAR:?message} to fail if not set.

# ── Exchange API Keys (dormant live-trading path) ──
# Read by ai-signal-bot only when `trading.paper_trading: false` in
# config/settings.yaml AND ccxt is installed (pip install ccxt).
# Simulator mode (the default) ignores these entirely — leave empty.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# ── Grafana ──
GRAFANA_USER=admin
GRAFANA_PASSWORD=  # REQUIRED — generate with: openssl rand -base64 24

# ── Web UI (Vite build-time args) ──
# These are inlined into the JS bundle at Docker build time.
# REQUIRED for production — browser-facing WebSocket URLs.
# For local Docker: ws://localhost:8765, ws://localhost:8766
# For domain: wss://trading.example.com/ws-exchange, wss://trading.example.com/ws-signals
VITE_WS_EXCHANGE=  # REQUIRED — do not leave as localhost for production deployments
VITE_WS_SIGNALS=   # REQUIRED — do not leave as localhost for production deployments
# Shared secret for the signal publisher WS handshake + health endpoints.
# VITE_SIGNAL_TOKEN must equal AI_BOT_AUTH_TOKEN; empty on both = auth disabled.
VITE_SIGNAL_TOKEN=
# Shared secret for the exchange simulator control plane (order/cancel/
# start_trading/stop_trading/update_config/set_speed/replay). REQUIRED in prod.
# VITE_EXCHANGE_TOKEN must equal EXCHANGE_CONTROL_TOKEN — the UI sends it as an
# auth frame so the Order Form keeps working; the ai-bot and hft-bot read the
# same EXCHANGE_CONTROL_TOKEN via env_file.
EXCHANGE_CONTROL_TOKEN=  # REQUIRED — generate with: openssl rand -base64 24
VITE_EXCHANGE_TOKEN=     # REQUIRED — must equal EXCHANGE_CONTROL_TOKEN

# ── Inter-service WebSocket URLs ──
# Compose defaults already point at service DNS names — override only if you
# renamed services or run bots outside the compose network.
# WS_URL feeds ai-signal-bot → exchange-simulator (config/settings.yaml default
# is ws://localhost:8765 — the bot's own container, i.e. dead in Docker).
WS_URL=ws://exchange-simulator:8765
# HFT_EXCHANGE_WS_URL feeds hft-trade-bot → exchange-simulator via
# config.prod.yaml's ${HFT_EXCHANGE_WS_URL:-ws://exchange-simulator:8765}.
HFT_EXCHANGE_WS_URL=ws://exchange-simulator:8765

# docker-compose.hub.yml / .prod.yml — image tag to pull from the registry
# (defaults to "latest" when unset).
IMAGE_TAG=latest

# ── Metrics/health bind addresses ──
# Without these, both bind container loopback and Prometheus jobs (and the
# published health ports) dead-end — compose already sets them to 0.0.0.0.
AI_BOT_BIND_HOST=0.0.0.0
# Sim metrics/health server — unset inherits websocket.host (EXCHANGE_WS_HOST).
#EXCHANGE_METRICS_HOST=0.0.0.0

# ── Trading mode ──
# Paper trading is controlled by `trading.paper_trading` in
# ai-signal-bot/config/settings.yaml (default: true). There is no env var.

# ── AI Signal Bot ──
OPENAI_API_KEY=your_openai_api_key_here
# LLM fallback provider key (llm.provider: anthropic in config/settings.yaml).
ANTHROPIC_API_KEY=
# Auth token for inbound WS/health endpoints (see VITE_SIGNAL_TOKEN above).
AI_BOT_AUTH_TOKEN=
# Ops-alert channels (optional; alerting.enabled in config/settings.yaml gates all).
ALERT_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK=
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
